# Copy outside the repository to an owner-only file; replace all placeholders.
# Generate a random hex password (avoids URL and Compose interpolation escaping).
POSTGRES_PASSWORD=replace-with-random-64-hex-digits
GATEWAY_PUBLIC_URL=https://gateway.example.com
GATEWAY_KEY_FILE=/absolute/private/path/vault-keys.json
GATEWAY_IMAGE=mcp-gateway-server:0.1.0
GATEWAY_PORT=8080
# On Linux, key file owner must match this unprivileged service identity.
GATEWAY_UID=10001
GATEWAY_GID=10001
